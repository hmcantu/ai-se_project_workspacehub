{
  "info": {
    "_postman_id": "fb4f8d9d-7f67-4d37-9fe1-b5d4674d3cbc",
    "name": "Comment API Edge Cases",
    "description": "QA checks for invalid comment payloads, malformed ids, and unexpected fields against the comments API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "ownerEmail",
      "value": "owner@workspacehub.dev",
      "type": "string"
    },
    {
      "key": "ownerPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "const json = pm.response.json();\n",
                  "pm.collectionVariables.set(\"ownerToken\", json.data.token);\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "const json = pm.response.json();\n",
                  "if (json.data && json.data.length) {\n  pm.collectionVariables.set(\"projectId\", String(json.data[0]._id));\n}\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create a task for edge case testing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Comment edge case task\",\n  \"description\": \"Temporary task for invalid comment payload QA\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {\n  pm.response.to.have.status(201);\n});\n",
                  "const json = pm.response.json();\n",
                  "pm.collectionVariables.set(\"taskId\", String(json.data._id));\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
