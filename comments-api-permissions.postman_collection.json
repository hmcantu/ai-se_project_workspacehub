    {
      "name": "Setup",
      "item": [
        {
          "name": "List projects as owner",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}/projects"],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "const json = pm.response.json();\n",
                  "if (json.data && json.data.length) {\n  pm.collectionVariables.set(\"projectId\", String(json.data[0]._id));\n}\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create task for comment tests",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Comment permission checks\",\n  \"description\": \"Temporary task for comment permission testing\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\",\n  \"assignedTo\": \"{{memberUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}/tasks"],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {\n  pm.response.to.have.status(201);\n});\n",
                  "const json = pm.response.json();\n",
                  "pm.collectionVariables.set(\"taskId\", String(json.data._id));\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
