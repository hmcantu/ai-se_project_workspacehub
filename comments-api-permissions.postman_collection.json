  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as owner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}/auth/login"],
              "variable": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {\n  pm.response.to.have.status(200);\n});\n",
                  "const json = pm.response.json();\n",
                  "pm.collectionVariables.set(\"ownerToken\", json.data.token);\n",
                  "pm.collectionVariables.set(\"ownerUserId\", String(json.data.user._id));\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
